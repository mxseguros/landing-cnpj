# Copie para .env.local e preencha. NUNCA comite .env.local.
#
# .env.example é o arquivo versionado: ele documenta QUAIS variáveis existem,
# sem revelar nenhum valor.

# --- Agente MX Empresas ---
# platform.claude.com -> Settings -> API Keys
# Use uma chave dedicada a este projeto, não a mesma do sistema de DRE:
# se precisar revogar uma, a outra continua de pé.
ANTHROPIC_API_KEY=

# --- Banco (Fase 4) ---
# Preenchido automaticamente por `vercel env pull` após provisionar o Neon
# via `vercel integration`.
DATABASE_URL=

# --- Notificação ao corretor (Fase 4) ---
RESEND_API_KEY=

# --- WhatsApp da célula B2B ---
# Só o número, sem segredo. Formato internacional, apenas dígitos.
# PENDENTE: definir se é o (19) 3863-8150 institucional ou um número dedicado.
NEXT_PUBLIC_WHATSAPP_CELULA=
